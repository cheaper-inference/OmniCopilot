{
  "name": "omnicopilot",
  "displayName": "OmniRoute by Cheaper Inference for GitHub Copilot Chat",
  "description": "OmniRoute by Cheaper Inference. Created by Diego Souza. Unified AI router, MIT, self-hosted, free.",
  "version": "1.5.1",
  "publisher": "diegosouzapw",
  "author": {
    "name": "Diego Souza",
    "url": "https://github.com/diegosouzapw"
  },
  "license": "MIT",
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#11120f",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cheaper-inference/OmniCopilot.git"
  },
  "bugs": {
    "url": "https://github.com/cheaper-inference/OmniCopilot/issues"
  },
  "homepage": "https://github.com/cheaper-inference/OmniRoute",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "language-models",
    "copilot",
    "github-copilot",
    "byok",
    "openai-compatible",
    "omniroute",
    "llm",
    "ai",
    "chat",
    "proxy",
    "router",
    "free-models",
    "claude",
    "gpt",
    "gemini",
    "deepseek",
    "kimi",
    "glm",
    "qwen",
    "ollama",
    "agent-mode",
    "tool-calling"
  ],
  "badges": [
    {
      "url": "https://img.shields.io/github/stars/cheaper-inference/OmniRoute?style=social",
      "description": "Star OmniRoute on GitHub",
      "href": "https://github.com/cheaper-inference/OmniRoute"
    }
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "omnicopilot",
          "title": "OmniRoute",
          "icon": "assets/activity-icon.svg"
        }
      ]
    },
    "views": {
      "omnicopilot": [
        {
          "type": "webview",
          "id": "omnicopilot.panel",
          "name": "%view.connection%",
          "icon": "assets/activity-icon.svg"
        }
      ]
    },
    "languageModelChatProviders": [
      {
        "vendor": "omniroute",
        "displayName": "OmniRoute",
        "icon": {
          "light": "assets/provider-light.svg",
          "dark": "assets/provider-dark.svg"
        },
        "managementCommand": "omnicopilot.manage"
      }
    ],
    "commands": [
      {
        "command": "omnicopilot.manage",
        "category": "OmniRoute",
        "title": "%cmd.manage%"
      },
      {
        "command": "omnicopilot.setApiKey",
        "category": "OmniRoute",
        "title": "%cmd.setApiKey%"
      },
      {
        "command": "omnicopilot.refreshModels",
        "category": "OmniRoute",
        "title": "%cmd.refreshModels%"
      },
      {
        "command": "omnicopilot.checkConnection",
        "category": "OmniRoute",
        "title": "%cmd.checkConnection%"
      },
      {
        "command": "omnicopilot.openDashboard",
        "category": "OmniRoute",
        "title": "%cmd.openDashboard%"
      },
      {
        "command": "omnicopilot.openGitHub",
        "category": "OmniRoute",
        "title": "%cmd.openGitHub%"
      },
      {
        "command": "omnicopilot.installOmniRoute",
        "category": "OmniRoute",
        "title": "%cmd.installOmniRoute%"
      },
      {
        "command": "omnicopilot.configureCliTool",
        "category": "OmniRoute",
        "title": "%cmd.configureCliTool%"
      },
      {
        "command": "omnicopilot.quickActions",
        "category": "OmniRoute",
        "title": "%cmd.quickActions%"
      },
      {
        "command": "omnicopilot.openSettings",
        "category": "OmniRoute",
        "title": "%cmd.openSettings%"
      }
    ],
    "walkthroughs": [
      {
        "id": "omnicopilot.gettingStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "run",
            "title": "%walkthrough.run.title%",
            "description": "%walkthrough.run.description%",
            "media": {
              "markdown": "media/walkthrough/run.md"
            },
            "completionEvents": [
              "onContext:omnicopilot.serverOnline"
            ]
          },
          {
            "id": "connect",
            "title": "%walkthrough.connect.title%",
            "description": "%walkthrough.connect.description%",
            "media": {
              "markdown": "media/walkthrough/connect.md"
            },
            "completionEvents": [
              "onCommand:omnicopilot.manage"
            ]
          },
          {
            "id": "pickModel",
            "title": "%walkthrough.pickModel.title%",
            "description": "%walkthrough.pickModel.description%",
            "media": {
              "markdown": "media/walkthrough/pick-model.md"
            },
            "completionEvents": [
              "onCommand:workbench.action.chat.manage",
              "onCommand:workbench.action.chat.openModelPicker"
            ]
          },
          {
            "id": "utility",
            "title": "%walkthrough.utility.title%",
            "description": "%walkthrough.utility.description%",
            "media": {
              "markdown": "media/walkthrough/utility.md"
            },
            "completionEvents": [
              "onSettingChanged:chat.utilityModel",
              "onCommand:workbench.action.openSettings"
            ]
          }
        ]
      }
    ],
    "configuration": {
      "title": "OmniRoute for Copilot",
      "properties": {
        "omnicopilot.baseUrl": {
          "type": "string",
          "default": "http://localhost:20128",
          "scope": "window",
          "order": 1,
          "description": "%cfg.baseUrl%"
        },
        "omnicopilot.statusBar": {
          "type": "boolean",
          "default": true,
          "order": 2,
          "description": "%cfg.statusBar%"
        },
        "omnicopilot.statusBarUsage": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "order": 3,
          "description": "%cfg.statusBarUsage%"
        },
        "omnicopilot.healthCheckIntervalSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "maximum": 3600,
          "order": 4,
          "description": "%cfg.healthCheckIntervalSeconds%"
        },
        "omnicopilot.maxOutputTokens": {
          "type": "number",
          "default": 16384,
          "minimum": 256,
          "order": 5,
          "description": "%cfg.maxOutputTokens%"
        },
        "omnicopilot.defaultContextLength": {
          "type": "number",
          "default": 128000,
          "minimum": 1024,
          "order": 6,
          "description": "%cfg.defaultContextLength%"
        },
        "omnicopilot.modelFilter": {
          "type": "string",
          "default": "",
          "order": 7,
          "description": "%cfg.modelFilter%"
        },
        "omnicopilot.dashboardOpen": {
          "type": "string",
          "enum": [
            "external",
            "editor"
          ],
          "enumDescriptions": [
            "%cfg.dashboardOpen.external%",
            "%cfg.dashboardOpen.editor%"
          ],
          "default": "external",
          "order": 8,
          "description": "%cfg.dashboardOpen%"
        },
        "omnicopilot.defaultReasoningEffort": {
          "type": "string",
          "enum": [
            "",
            "none",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "enumDescriptions": [
            "%cfg.defaultReasoningEffort.unset%",
            "%cfg.defaultReasoningEffort.none%",
            "%cfg.defaultReasoningEffort.low%",
            "%cfg.defaultReasoningEffort.medium%",
            "%cfg.defaultReasoningEffort.high%",
            "%cfg.defaultReasoningEffort.xhigh%",
            "%cfg.defaultReasoningEffort.max%"
          ],
          "default": "",
          "order": 9,
          "description": "%cfg.defaultReasoningEffort%"
        },
        "omnicopilot.cliPath": {
          "type": "string",
          "default": "omniroute",
          "scope": "machine",
          "order": 10,
          "description": "%cfg.cliPath%"
        },
        "omnicopilot.exposeToAgentsWindow": {
          "type": "boolean",
          "default": false,
          "order": 11,
          "description": "%cfg.exposeToAgentsWindow%"
        },
        "omnicopilot.sendProjectName": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "order": 12,
          "description": "%cfg.sendProjectName%"
        }
      }
    }
  },
  "scripts": {
    "compile": "npm run check-types && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "icon": "node scripts/render-icon.mjs",
    "l10n:check": "node scripts/l10n-check.mjs",
    "package": "npm run check-types && node esbuild.mjs --production",
    "vscode:prepublish": "npm run package",
    "vsix": "vsce package -o omnicopilot.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.104.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.15.0",
    "sharp": "^0.35.5",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.39.0",
    "vitest": "^5.0.5"
  }
}
